#!/sbin/sh
# MI10s 通信与屏幕掉帧修复 v2.0 —— 通用安装入口
# 兼容：Magisk（走官方 util_functions / install_module）、
#       KernelSU / APatch（自带解压兜底；KernelSU 通常直接执行 customize.sh，本文件作为兜底）

OUTFD=$2
ZIPFILE=$3

ui_print() { echo "$1"; }
abort() { ui_print "! $1"; exit 1; }

# ---------- 1) Magisk：走官方安装流程（自动解压 + 运行 customize.sh + 设权限/sepolicy） ----------
if [ -f /data/adb/magisk/util_functions.sh ]; then
    . /data/adb/magisk/util_functions.sh
    install_module
    exit 0
fi

# ---------- 2) 兜底：自行解压安装 ----------
BB=""
for c in /data/adb/ksu/bin/busybox /data/adb/ap/bin/busybox /data/adb/magisk/busybox /system/bin/busybox /system/xbin/busybox; do
    [ -x "$c" ] && { BB="$c"; break; }
done
if [ -n "$BB" ]; then
    UNZIP="$BB unzip"
elif command -v unzip >/dev/null 2>&1; then
    UNZIP="unzip"
else
    abort "busybox/unzip not found"
fi

TMPDIR=/dev/tmp
mkdir -p "$TMPDIR" 2>/dev/null
mount /data 2>/dev/null

$UNZIP -o "$ZIPFILE" module.prop -d "$TMPDIR" >&2
[ ! -f "$TMPDIR/module.prop" ] && abort "无法解压 zip"
MODID=$(grep '^id=' "$TMPDIR/module.prop" | cut -c4- | tr -d '\r ')
[ -z "$MODID" ] && abort "无法获取模块 id"
MODPATH=/data/adb/modules/$MODID

rm -rf "$MODPATH"
mkdir -p "$MODPATH"
$UNZIP -o "$ZIPFILE" -x 'META-INF/*' -d "$MODPATH" >&2

[ -f "$MODPATH/customize.sh" ] && MODPATH="$MODPATH" sh "$MODPATH/customize.sh"

chmod 0755 "$MODPATH"/*.sh "$MODPATH"/META-INF/com/google/android/update-binary 2>/dev/null
chown -R 0:0 "$MODPATH" 2>/dev/null

ui_print "- 已安装: $MODID"
ui_print "- 重启后生效"
exit 0
